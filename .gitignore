# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Build directories
build/
.build/
prjxray/build/

# Build artifacts and outputs
*.bit
*.frames
*.uf2
*.fasm

# Dependencies (cache only, not version controlled)
.deps/
prjxray-db/

# Temporary directories
.validation/

# Generated synthesis/routing artifacts
examples/vc707-johnson/johnson.json
examples/vc707-johnson/johnson.fasm

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride.chipdb/

# self-verification working files (regenerable)
.verify/
examples/arty-blinky/blinky.json
examples/arty-blinky/blinky.fasm
examples/arty-blinky/blinky_placement.json

# LiteX build products (regenerable -- see examples/vc707-litex/README.md)
examples/vc707-litex/build*/
examples/vc707-litex-ddr/build*/
examples/vc707-litex-eth/build*/
examples/vc707-litex-ddr-eth/build*/
examples/vc707-litex-ddr-ethmin/build*/
examples/vc707-litex-ddr-ethmin/vivado-pnr/

# The Linux emulator's build products; the sources beside them are the point.
examples/vc707-litex-linux/emulator/*.o
examples/vc707-litex-linux/emulator/*.d
examples/vc707-litex-linux/emulator/*.elf
examples/vc707-litex-linux/emulator/*.bin
examples/vc707-telegraph/build*/
examples/vc707-telegraph/.Xil/
examples/vc707-telegraph/*.json
examples/vc707-telegraph/*.fasm

# The netbooted self-test's build products; main.c and the Makefile are the
# source, and the image is only valid for the SoC it was compiled against.
examples/vc707-litex-testapp/*.o
examples/vc707-litex-testapp/*.d
examples/vc707-litex-testapp/*.elf
examples/vc707-litex-testapp/*.elf.map
examples/vc707-litex-testapp/*.bin

# Sweep/extraction products for the checked-in LiteX gateware: the .v, .xdc
# and .init files are the source, everything derived from them is not.
examples/vc707-litex/gateware/*.json
examples/vc707-litex/gateware/*_gates.v
examples/vc707-litex/gateware/*.fasm

# the yosys install prefix CI builds (see scripts/pinned_yosys.sh)
yosys-install/
