# Kernel for the ROM-booted VC707 SoC: tinyconfig plus this fragment, after
# sonata-linux's linux/config/ram-additions.config -- size first, then only
# what this SoC (VexRiscv-SMP linux, one hart, 1 GB DDR3, LiteEth) needs.
#
#   make ARCH=riscv O=<build> tinyconfig
#   scripts/kconfig/merge_config.sh -m -O <build> <build>/.config romlinux.config
#   make ARCH=riscv O=<build> olddefconfig

# Architecture: rv32ima (M and A are implied) -- no compressed instructions, no FPU
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
# CONFIG_RISCV_ISA_C is not set
# CONFIG_FPU is not set
# CONFIG_SMP is not set
# CONFIG_EFI is not set
CONFIG_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y
CONFIG_PHYS_RAM_BASE_FIXED=y
CONFIG_PHYS_RAM_BASE=0x40000000
CONFIG_MMU=y

# Size
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EXPERT=y
# CONFIG_BASE_FULL is not set
CONFIG_SLUB_TINY=y
# CONFIG_KALLSYMS is not set
# CONFIG_MODULES is not set

# The root filesystem is an uncompressed initramfs: the unpacker in the ROM
# has already decompressed it, so no RD_* decompressor is built in
CONFIG_BLK_DEV_INITRD=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set

# Console
CONFIG_TTY=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_SERIAL_LITEUART=y
CONFIG_SERIAL_LITEUART_CONSOLE=y
CONFIG_SERIAL_LITEUART_MAX_PORTS=1

# Interrupts, timer, SoC
CONFIG_SIFIVE_PLIC=y
CONFIG_RISCV_TIMER=y
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_LITEX=y
CONFIG_LITEX=y
CONFIG_LITEX_SOC_CONTROLLER=y

# Ethernet (LiteEth on ethmin's SGMII PHY)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_LITEX=y
CONFIG_LITEX_LITEETH=y

# Userland: busybox against glibc
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_UNIX98_PTYS=y
