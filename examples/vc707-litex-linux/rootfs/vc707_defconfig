# Buildroot config for the open-flow VC707 SoC.
#
# Derived from linux-on-litex-vexriscv's litex_vexriscv_defconfig, which
# already targets this CPU exactly: rv32ima with compressed instructions
# explicitly off, ILP32, and userspace built against 6.9 kernel headers.
# That last one is the point of rebuilding: the f4pga rootfs was built for a
# 5.x kernel and dies on 6.9 with "poll: Function not implemented", because
# riscv has only ever had ppoll and whatever supplied poll() is long gone.
#
# What is dropped from the reference is everything that builds a *different*
# boot path: this SoC has its own kernel build, uses the 6 KB emulator rather
# than OpenSBI, and netboots a cpio over TFTP rather than writing an SD card.

# Target: rv32ima/ilp32, no compressed -- VexRiscv has no C extension.
BR2_riscv=y
BR2_RISCV_32=y
BR2_riscv_custom=y
BR2_RISCV_ISA_CUSTOM_RVM=y
BR2_RISCV_ISA_CUSTOM_RVA=y
BR2_RISCV_ISA_CUSTOM_RVC=n
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ISA_RVC=n
BR2_RISCV_ABI_ILP32=y

# libc: glibc, chosen rather than defaulted.
#
# The goal for this board is to run nextpnr on it (see the roadmap's stage 6),
# and that is a large C++ program linking libstdc++.  glibc is the
# best-supported libc for that, and the size argument against it -- sonata's
# "saves ~2MB in rootfs, critical for 8MB RAM" -- is irrelevant at 512 MiB.
#
# Worth recording how this was found, because it was nearly missed.  With the
# headers series misconfigured, BR2_TOOLCHAIN_HEADERS_AT_LEAST resolved to 2.6,
# glibc was therefore unavailable, and buildroot fell back to uclibc-ng.  That
# fallback was read as a considered default and reasoned about as one.  Fixing
# the headers made glibc selectable and it became the default; pinning it here
# makes it a decision instead of a second accident pointing the same way.
# Changing this later needs a clean output directory.  The libc is part of the
# toolchain triplet (…-linux-gnu vs …-linux-uclibc), and buildroot's stamps
# will say gcc is built when it is built for the *other* triplet -- the next
# package then fails with "cannot compile" and $? = 127.  Pinning it here means
# the triplet is fixed at the first configure rather than emerging from
# whichever libc happened to be available.
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y

BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_LITEX_VEXRISCV_PATH)/patches"
BR2_GCC_VERSION_13_X=y

# Userspace against 6.9 headers -- this is what fixes the ENOSYS.
#
# Two symbols, and both are required.  BR2_KERNEL_HEADERS_VERSION picks which
# tarball to fetch; BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_9 declares which
# series to assume.  Without the second, buildroot assumes 2.6 and
# check-kernel-headers.sh fails the staging install with "expected 2.6.x, got
# 6.9.x" -- after downloading 137 MB and building most of a toolchain.
#
# The default, left alone, is 6.19.6: newer than the kernel this userspace
# runs on, which is the wrong direction.  Headers must not exceed the kernel.
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="6.9"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_9=y


# A getty on the console the kernel gives us (liteuart0).
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="console"

# The netboot payload is a cpio loaded at 0x40800000; nothing else is wanted.
BR2_TARGET_ROOTFS_CPIO=y

BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_LITEX_VEXRISCV_PATH)/../../../examples/vc707-litex-linux/rootfs/busybox.fragment"

# Measuring the link needs a load generator on the target.  ping RTT shows
# whether interrupts are working (7-16 ms polling vs ~1 ms with an IRQ); this
# is for throughput once they are.
BR2_PACKAGE_IPERF3=y

# CoreMark: a CPU number for this SoC that can be compared with published
# ones, which iperf3 (a network measurement) cannot give.  Small, self
# contained, and it runs from the NFS root without anything else installed.
# Report it with the compiler flags and the clock rate beside it -- a bare
# CoreMark score means nothing on its own.
BR2_PACKAGE_COREMARK=y

# A native toolchain on the board.  tcc was the answer when the target had
# 8 MB of RAM; with 512 MB of DDR3 and the root filesystem on NFS rather
# than an initramfs competing for that RAM, neither size nor space is the
# constraint any more, so this is a real gcc instead.
#
# Buildroot has no native-gcc option -- gcc-final's target install copies
# only the runtime libraries -- so package/gcc-native Canadian-crosses it,
# the same shape binutils already uses to put as and ld on the target.
# gcc has been written in C++ since 4.8, so a native gcc needs a C++ cross
# compiler to build it -- and a board that compiles its own code wants C++
# on it regardless.  This changes the toolchain, so it forces a full
# rebuild of the rootfs; the working images are kept in
# ~/vc707-artifacts/pre-cxx-rootfs in case this needs backing out.
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_PACKAGE_BINUTILS=y
BR2_PACKAGE_BINUTILS_TARGET=y
BR2_PACKAGE_GMP=y
BR2_PACKAGE_MPFR=y
BR2_PACKAGE_MPC=y
BR2_PACKAGE_GCC_NATIVE=y

# Dropbear gives us sshd (and dbclient) in a fraction of openssh's size,
# which matters in an initramfs that has to fit in RAM alongside the
# kernel.  Dropbear refuses to authenticate an account with an empty
# password, and buildroot leaves root's empty by default, so a password
# has to be set or sshd is installed but unusable.
BR2_PACKAGE_DROPBEAR=y
BR2_TARGET_GENERIC_ROOT_PASSWD="vc707"


# OpenSBI, the M-mode firmware for the VexRiscv-SMP SoC.  It replaces the 6 KB
# emulator, which existed only because the plain VexRiscv SoC had no CLINT at
# 0xF0010000 and no PLIC at 0xf0c00000 -- exactly what this platform expects,
# and exactly what the SMP core provides.  litex-hub's fork, as the reference
# config uses.
BR2_TARGET_OPENSBI=y
BR2_TARGET_OPENSBI_CUSTOM_GIT=y
BR2_TARGET_OPENSBI_CUSTOM_REPO_URL="https://github.com/litex-hub/opensbi.git"
BR2_TARGET_OPENSBI_CUSTOM_REPO_VERSION="1.3.1-linux-on-litex-vexriscv"
BR2_TARGET_OPENSBI_PLAT="litex/vexriscv"
BR2_TARGET_OPENSBI_INSTALL_DYNAMIC_IMG=n

# Two overlays, applied in order.  Ours carries fixed dropbear host keys:
# the rootfs is an initramfs in RAM, so without them dropbear generates a
# fresh host key on every boot and every ssh client refuses to reconnect.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_LITEX_VEXRISCV_PATH)/board/litex_vexriscv/rootfs_overlay $(TOPDIR)/../../examples/vc707-litex-linux/rootfs/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(TOPDIR)/../../examples/vc707-litex-linux/rootfs/post-build.sh"
