/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	compatible = "enjoy-digital,litex-vexriscv-soclinux";
	model = "VexRiscv SoCLinux on VC707 (open flow)";

	chosen {
		bootargs = "mem=512M@0x40000000 rootwait console=liteuart earlycon=sbi root=/dev/ram0 init=/sbin/init swiotlb=32";
		linux,initrd-start = <0x40800000>;
		linux,initrd-end   = <0x40bdfe00>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		timebase-frequency = <100000000>;

		cpu@0 {
			clock-frequency = <0x00>;
			compatible = "spinalhdl,vexriscv\0sifive,rocket0\0riscv";
			d-cache-block-size = <0x40>;
			d-cache-sets = <0x40>;
			d-cache-size = <0x8000>;
			d-tlb-sets = <0x01>;
			d-tlb-size = <0x20>;
			device_type = "cpu";
			i-cache-block-size = <0x40>;
			i-cache-sets = <0x40>;
			i-cache-size = <0x8000>;
			i-tlb-sets = <0x01>;
			i-tlb-size = <0x20>;
			mmu-type = "riscv,sv32";
			reg = <0x00>;
			riscv,isa = "rv32ima";
			sifive,itim = <0x01>;
			status = "okay";
			tlb-split;

			interrupt-controller {
				#interrupt-cells = <0x01>;
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				phandle = <0x01>;
			};
		};
	};

	/* 512 MiB of DDR3 at 0x40000000 -- the VC707's MT8JTF12864 SODIMM. */
	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x20000000>;
	};

	soc {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		/* CSR base is 0xf0000000; uart sits at +0x3800 in this build.
		   Read from the SoC's own csr.json rather than assumed -- the
		   Arty demo this tree derives from has it at 0xf0001800. */
		/* LiteEth MAC, in the NAMED-region binding the 6.9 driver requires.
		   The older index-based form (mac, mdio, buffer as three unnamed reg
		   entries) is what the 5.0.13-era Arty dtb used; on 6.9 it probes as
		     liteeth f0001800.mac: invalid resource (null)
		     probe with driver liteeth failed with error -22
		   because the driver looks the regions up BY NAME.  The working SMP
		   tree for this same kernel uses exactly this shape, which is the
		   evidence it is right.
		
		   No mdio region: the ethmin PHY is a black box with no MDIO block.
		   Slot geometry comes from this SoC's csr.json -- ethmac_rx_slots and
		   ethmac_tx_slots are 2, ethmac_slot_size is 2048.
		
		   No interrupts property, so the driver polls: this SoC has no
		   interrupt controller node (it predates the PLIC the SMP cluster
		   brings, and LiteX dropped its vexriscv,intc0 emission in
		   df92e2aea).  The driver says so and carries on:
		     Failed to get IRQ, using polling
		   which is a warning, not the failure above. */
		mac@f0001800 {
			compatible = "litex,liteeth";
			reg = <0x00 0xf0001800 0x00 0x7c>,
			      <0x00 0x80000000 0x00 0x2000>;
			reg-names = "mac", "buffer";
			litex,rx-slots = <0x02>;
			litex,tx-slots = <0x02>;
			litex,slot-size = <0x800>;
			local-mac-address = [10 e2 d5 00 00 07];
			status = "okay";
		};

		serial@f0004000 {
			device_type = "serial";
			compatible = "litex,liteuart";
			reg = <0x00 0xf0004000 0x00 0x100>;
			status = "okay";
		};
	};

	aliases {
		serial0 = "/soc/serial@f0004000";
	};
};
